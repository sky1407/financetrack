# Skopiruj tento subor na .env a uprav podla potreby
DATABASE_URL="postgresql://financetrack:financetrack@localhost:5432/financetrack?schema=public"

PORT=4000
NODE_ENV=development

# Adresa frontendu, kvoli CORS + cookies
CLIENT_ORIGIN=http://localhost:5173

# Nahradit nahodnym dlhym retazcom v produkcii (napr. `openssl rand -hex 32`)
JWT_SECRET=change_this_dev_secret_change_this_dev_secret
JWT_EXPIRES_IN=7d
