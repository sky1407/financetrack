# Copy this file to .env and adjust as needed
DATABASE_URL="postgresql://financetrack:financetrack@localhost:5432/financetrack?schema=public"

PORT=4000
NODE_ENV=development

# Frontend origin, needed for CORS + cookies
CLIENT_ORIGIN=http://localhost:5173

# Replace with a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_this_dev_secret_change_this_dev_secret
JWT_EXPIRES_IN=7d

# Redis for the statement import queue (docker compose up -d redis); imports are disabled when unset
REDIS_URL=redis://localhost:6379
