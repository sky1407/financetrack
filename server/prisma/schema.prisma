// Prisma schema for FinanceTrack
// Run: `npx prisma migrate dev` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CASH
  BANK
  CARD
  SAVINGS
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ImportStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  importBatches ImportBatch[]

  @@map("users")
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType @default(BANK)
  currency       String      @default("EUR")
  initialBalance Decimal     @default(0) @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transactions  Transaction[]
  importBatches ImportBatch[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      CategoryType
  color     String       @default("#64748b")
  icon      String       @default("tag")
  createdAt DateTime     @default(now())

  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, type])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  note          String?
  date          DateTime
  /// Hash of the source statement row; null for manually entered transactions.
  fingerprint   String?
  importBatchId String?
  importBatch   ImportBatch?    @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  /// Re-importing the same statement into an account must not create duplicates (NULLs never collide).
  @@unique([accountId, fingerprint])
  @@index([importBatchId])
  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
  @@map("transactions")
}

/// One uploaded bank statement and the outcome of processing it in the background.
model ImportBatch {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fileName    String
  status      ImportStatus @default(PENDING)
  /// Uploaded CSV kept only until the worker processes it, then cleared.
  rawContent  String?
  imported    Int          @default(0)
  duplicates  Int          @default(0)
  /// [{ row, reason }] for rows that were not imported.
  skippedRows Json?
  error       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  completedAt DateTime?

  transactions Transaction[]

  @@index([userId, createdAt])
  @@index([accountId])
  @@map("import_batches")
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  month      Int
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
  @@map("budgets")
}
